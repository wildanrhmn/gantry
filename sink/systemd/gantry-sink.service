[Unit]
Description=Gantry Substreams sink (reverted v4 attempts into Postgres)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gantry/db.env
ExecStart=/usr/local/bin/substreams sink postgres /opt/gantry/gantry-v0.1.0.spkg map_attempts --dsn ${PGDSN} -s 25940000
Restart=always
RestartSec=15
# leave the lp-agent its memory: the sink is capped well under what is free
MemoryMax=420M
MemoryHigh=360M
Nice=10
StandardOutput=append:/var/log/gantry-sink.log
StandardError=append:/var/log/gantry-sink.log

[Install]
WantedBy=multi-user.target
